# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aibot
# Or for SQLite (for development)
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (GPT)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id

# Google AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# xAI (Grok)
GROK_API_KEY=your_grok_api_key_here

# Payment Systems
# Telegram Stars (built-in, no key needed)

# YooKassa (for RФ)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# Bot Settings
DEFAULT_TOKEN_LIMIT=100000
FREE_TOKENS_ON_REGISTER=10000
ENABLE_VOICE_MESSAGES=true
ENABLE_REFERRAL_SYSTEM=true
REFERRAL_BONUS=5000

# Image Generation
DALLE_MODEL=dall-e-3
STABLE_DIFFUSION_API_KEY=your_sd_key

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn

# Limits
MAX_CONTEXT_LENGTH=10
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_PERIOD=60

# Features
ENABLE_GPT4=true
ENABLE_GPT4O=true
ENABLE_GEMINI_PRO=true
ENABLE_GROK=true
